#!/usr/bin/env nix-shell
#!nix-shell -i python3 -p "python3.withPackages (ps: [ ps.pyyaml ])" sops age ssh-to-age

"""Read-only diagnostics for the sops/age secrets setup.

Usage:
  snowman-secrets-doctor [status]   full report (identities, recipients, decrypt probes)
  snowman-secrets-doctor verify     recipient-drift check only; exit 1 on drift (CI/pre-commit safe)

This tool NEVER writes anything and NEVER prints secret values or private
keys — only public keys and yes/no results.

What it checks:
  - which decryption identities exist on this machine
    (/var/lib/sops-nix/age.key, SSH host key, user SSH key)
    and which .sops.yaml entry each one corresponds to
  - per encrypted file: the age recipients actually embedded in the file
    vs the recipients .sops.yaml says it should have
    (drift here means `sops updatekeys` was not run after editing .sops.yaml
     — exactly how machines quietly lose the ability to decrypt)
  - (status only) whether each file can actually be decrypted with the
    identities available on this machine
"""

import json
import os
import re
import subprocess
import sys
import tempfile

import yaml

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SOPS_YAML = os.path.join(REPO_ROOT, ".sops.yaml")
SYSTEM_AGE_KEY = "/var/lib/sops-nix/age.key"
HOST_SSH_PUB = "/etc/ssh/ssh_host_ed25519_key.pub"
HOST_SSH_PRIV = "/etc/ssh/ssh_host_ed25519_key"
STATE_FILE = "/var/lib/snowman/secrets-state.json"

GREEN, RED, YELLOW, DIM, BOLD, RESET = (
    "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[1m", "\033[0m",
)
if not sys.stdout.isatty():
    GREEN = RED = YELLOW = DIM = BOLD = RESET = ""

OK = f"{GREEN}✔{RESET}"
BAD = f"{RED}✘{RESET}"
WARN = f"{YELLOW}⚠{RESET}"


def run(cmd, input_text=None, env=None):
    """Run a command; return (returncode, stdout). Never raises."""
    try:
        r = subprocess.run(
            cmd, input=input_text, capture_output=True, text=True,
            env=env, timeout=60,
        )
        return r.returncode, r.stdout.strip()
    except Exception:
        return 1, ""


def load_sops_config():
    with open(SOPS_YAML) as f:
        data = yaml.safe_load(f)
    names = data.get(".keys", {}) or {}
    key_to_name = {v: k for k, v in names.items()}
    rules = []
    for rule in data.get("creation_rules", []):
        expected = []
        for group in rule.get("key_groups", []):
            expected.extend(group.get("age", []) or [])
        rules.append((rule.get("path_regex", ""), expected))
    return key_to_name, rules


def expected_recipients(relpath, rules):
    for regex, expected in rules:
        if re.search(regex, relpath):
            return expected
    return None


def actual_recipients(path):
    with open(path) as f:
        data = yaml.safe_load(f)
    sops_meta = (data or {}).get("sops", {}) or {}
    return [e["recipient"] for e in sops_meta.get("age", []) or [] if "recipient" in e]


def secret_files():
    rc, out = run(["git", "-C", REPO_ROOT, "ls-files"])
    if rc != 0:
        return []
    return [
        f for f in out.splitlines()
        if f.endswith((".yml", ".yaml")) and "secrets" in f and f != ".sops.yaml"
    ]


def name_for(key, key_to_name):
    return key_to_name.get(key, f"{RED}UNKNOWN{RESET}")


def gather_identities(key_to_name):
    """Return list of dicts: {label, pubkey, name, priv} for identities on
    this machine. priv is a callable returning an age secret key file path
    (or None if unreadable) — used only for decrypt probes."""
    identities = []

    # 1. sops-nix age key file (root-owned)
    if os.path.exists(SYSTEM_AGE_KEY):
        if os.access(SYSTEM_AGE_KEY, os.R_OK):
            rc, pub = run(["age-keygen", "-y", SYSTEM_AGE_KEY])
            identities.append({
                "label": SYSTEM_AGE_KEY,
                "pubkey": pub if rc == 0 else None,
                "keyfile": SYSTEM_AGE_KEY,
            })
        else:
            identities.append({
                "label": f"{SYSTEM_AGE_KEY} (present, not readable — rerun with sudo for details)",
                "pubkey": None,
                "keyfile": None,
            })

    # 2. SSH host key (Linux hosts)
    if os.path.exists(HOST_SSH_PUB):
        rc, pub = run(["ssh-to-age"], input_text=open(HOST_SSH_PUB).read())
        keyfile = None
        if os.access(HOST_SSH_PRIV, os.R_OK):
            rc2, priv = run(["ssh-to-age", "-private-key", "-i", HOST_SSH_PRIV])
            if rc2 == 0 and priv:
                tf = tempfile.NamedTemporaryFile(
                    mode="w", delete=False, prefix="doctor-age-", suffix=".key")
                os.chmod(tf.name, 0o600)
                tf.write(priv + "\n")
                tf.close()
                keyfile = tf.name
        identities.append({
            "label": f"SSH host key ({HOST_SSH_PUB})",
            "pubkey": pub if rc == 0 else None,
            "keyfile": keyfile,
        })

    # 3. User SSH key (the Darwin/standalone identity)
    user_pub = os.path.expanduser("~/.ssh/id_ed25519.pub")
    user_priv = os.path.expanduser("~/.ssh/id_ed25519")
    if os.path.exists(user_pub):
        rc, pub = run(["ssh-to-age"], input_text=open(user_pub).read())
        keyfile = None
        if os.access(user_priv, os.R_OK):
            rc2, priv = run(["ssh-to-age", "-private-key", "-i", user_priv])
            if rc2 == 0 and priv:
                tf = tempfile.NamedTemporaryFile(
                    mode="w", delete=False, prefix="doctor-age-", suffix=".key")
                os.chmod(tf.name, 0o600)
                tf.write(priv + "\n")
                tf.close()
                keyfile = tf.name
        identities.append({
            "label": f"user SSH key ({user_pub})",
            "pubkey": pub if rc == 0 else None,
            "keyfile": keyfile,
        })

    for ident in identities:
        ident["name"] = (
            key_to_name.get(ident["pubkey"]) if ident["pubkey"] else None
        )
    return identities


def can_decrypt(path, keyfile):
    env = dict(os.environ)
    env["SOPS_AGE_KEY_FILE"] = keyfile
    # Strip other key sources so the probe tests exactly one identity.
    env.pop("SOPS_AGE_KEY", None)
    rc, _ = run(["sops", "--config", SOPS_YAML, "-d", os.path.join(REPO_ROOT, path)], env=env)
    return rc == 0


def check_files(key_to_name, rules, identities, probe):
    """Returns (report_lines, drift_found)."""
    lines = []
    drift = False
    for relpath in secret_files():
        full = os.path.join(REPO_ROOT, relpath)
        try:
            actual = actual_recipients(full)
        except Exception as e:
            lines.append(f"  {WARN} {relpath}: cannot parse ({e})")
            drift = True
            continue
        if not actual:
            lines.append(f"  {WARN} {relpath}: no sops age metadata (not encrypted?)")
            drift = True
            continue

        expected = expected_recipients(relpath, rules)
        lines.append(f"  {BOLD}{relpath}{RESET}")
        if expected is None:
            lines.append(f"    {WARN} no creation_rule in .sops.yaml matches this path")
            drift = True
            expected = []

        missing = [k for k in expected if k not in actual]
        extra = [k for k in actual if k not in expected]

        for k in actual:
            lines.append(f"    {DIM}recipient{RESET} {name_for(k, key_to_name)} {DIM}{k}{RESET}")
        for k in missing:
            lines.append(
                f"    {BAD} MISSING recipient {name_for(k, key_to_name)} "
                f"(declared in .sops.yaml — run: sops updatekeys --yes {relpath})"
            )
            drift = True
        for k in extra:
            if k not in key_to_name:
                lines.append(
                    f"    {BAD} ORPHAN recipient {k} — not in .sops.yaml at all. "
                    f"An unaccounted-for key can decrypt this file."
                )
                drift = True
            else:
                lines.append(
                    f"    {WARN} stale recipient {key_to_name[k]} "
                    f"(in file but not in matching .sops.yaml rule — run updatekeys)"
                )
                drift = True

        if probe:
            usable = [i for i in identities if i["keyfile"]]
            if not usable:
                lines.append(f"    {DIM}decrypt probe: no readable identities on this machine{RESET}")
            for ident in usable:
                ok = can_decrypt(relpath, ident["keyfile"])
                who = ident["name"] or ident["label"]
                if ok:
                    lines.append(f"    {OK} decrypts with {who}")
                else:
                    lines.append(f"    {BAD} CANNOT decrypt with {who}")
    return lines, drift


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "status"
    if mode not in ("status", "verify"):
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)

    if not os.path.exists(SOPS_YAML):
        print(f"ERROR: {SOPS_YAML} not found.", file=sys.stderr)
        sys.exit(2)

    key_to_name, rules = load_sops_config()
    identities = gather_identities(key_to_name) if mode == "status" else []

    try:
        if mode == "status":
            print(f"{BOLD}== snowman secrets doctor =={RESET}")

            if os.path.exists(STATE_FILE):
                try:
                    state = json.load(open(STATE_FILE))
                    print(
                        f"mode: {BOLD}{state.get('mode', '?')}{RESET} "
                        f"{DIM}(host {state.get('host', '?')}, activated {state.get('activatedAt', '?')}){RESET}"
                    )
                except Exception:
                    print(f"{WARN} {STATE_FILE} exists but is unreadable/invalid")
            else:
                print(f"{DIM}mode: unknown (no {STATE_FILE}; NixOS hosts write it on activation){RESET}")

            print(f"\n{BOLD}identities on this machine:{RESET}")
            if not identities:
                print(f"  {WARN} none found")
            for ident in identities:
                if ident["pubkey"] is None:
                    print(f"  {WARN} {ident['label']}")
                    continue
                known = ident["name"]
                mark = OK if known else WARN
                label_known = known or "NOT in .sops.yaml — this identity decrypts nothing"
                print(f"  {mark} {ident['label']}")
                print(f"      {DIM}{ident['pubkey']}{RESET} -> {label_known}")

            print(f"\n{BOLD}declared keys (.sops.yaml):{RESET}")
            for pub, name in sorted(key_to_name.items(), key=lambda kv: kv[1]):
                print(f"  {name}: {DIM}{pub}{RESET}")

            print(f"\n{BOLD}secret files:{RESET}")

        lines, drift = check_files(key_to_name, rules, identities, probe=(mode == "status"))
        for line in lines:
            print(line)

        if drift:
            print(f"\n{BAD} recipient drift detected — .sops.yaml and file metadata disagree.")
            print("   Fix: review .sops.yaml, then run `sops updatekeys --yes <file>` per file")
            print("   (or ./bin/snowman-rotate-keys, which always finishes with updatekeys).")
            sys.exit(1)
        else:
            print(f"\n{OK} no recipient drift: all files match .sops.yaml.")
            sys.exit(0)
    finally:
        for ident in identities:
            kf = ident.get("keyfile")
            if kf and kf.startswith(tempfile.gettempdir()):
                try:
                    os.unlink(kf)
                except OSError:
                    pass


if __name__ == "__main__":
    main()
