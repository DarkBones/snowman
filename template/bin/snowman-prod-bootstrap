#!/usr/bin/env bash

set -euo pipefail

# One-time authenticated rebuild for private GitHub flake inputs.
#
# Token sources, in order of preference:
#   1. TOKEN_FILE — a plain file holding just the PAT. Intended for cold
#      bootstrap from the SNOWMAN_KEY USB (e.g. /mnt/snowman/github-token),
#      where sops may not be usable yet.
#   2. A sops-encrypted file (SECRETS_FILE, key TOKEN_KEY) — requires a
#      working age identity on this machine.
#
# The token is injected only into this one nixos-rebuild via NIX_CONFIG;
# it is never written to disk, the nix store, or shell history.

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"

if [ $# -lt 1 ]; then
    echo "Usage: $(basename "$0") <host-name> " >&2
    echo "  env: TOKEN_FILE=/mnt/snowman/github-token  (plain token file, e.g. from USB)" >&2
    echo "       SECRETS_FILE=…  TOKEN_KEY=…            (sops file fallback)" >&2
    exit 1
fi

HOST="$1"
TOKEN_FILE="${TOKEN_FILE:-}"
SECRETS_FILE="${SECRETS_FILE:-${REPO_ROOT}/users/secrets/bas_secrets.yml}"
TOKEN_KEY="${TOKEN_KEY:-github_pat}"
# Private repo used to verify the token grants the access the rebuild needs.
CHECK_REPO="${CHECK_REPO:-DarkBones/dotfiles}"

if ! command -v nixos-rebuild >/dev/null 2>&1; then
    echo "ERROR: nixos-rebuild is required but not found in PATH." >&2
    exit 1
fi

echo "[snowman] Bootstrapping authenticated rebuild for host: $HOST"

token=""
if [ -n "$TOKEN_FILE" ]; then
    if [ ! -r "$TOKEN_FILE" ]; then
        echo "ERROR: TOKEN_FILE not readable: $TOKEN_FILE" >&2
        exit 1
    fi
    echo "[snowman] Reading token from file: $TOKEN_FILE"
    token="$(cat "$TOKEN_FILE")"
else
    if ! command -v sops >/dev/null 2>&1; then
        echo "ERROR: sops is required but not found in PATH (or set TOKEN_FILE)." >&2
        exit 1
    fi

    if [ ! -f "$SECRETS_FILE" ]; then
        echo "ERROR: Secrets file not found: $SECRETS_FILE" >&2
        exit 1
    fi

    echo "[snowman] Reading token key '$TOKEN_KEY' from: $SECRETS_FILE"
    token="$(sops -d --extract "[\"${TOKEN_KEY}\"]" "$SECRETS_FILE")"

    # `sops --extract` may return a JSON quoted string.
    if [[ "$token" == \"*\" ]]; then
        token="${token#\"}"
        token="${token%\"}"
    fi
fi

# Remove accidental line endings/spaces from copied tokens.
token="$(printf '%s' "$token" | tr -d '[:space:]')"

if [ -z "$token" ] || [ "$token" = "null" ]; then
    echo "ERROR: Token key '$TOKEN_KEY' is missing or empty in $SECRETS_FILE" >&2
    exit 1
fi

if command -v curl >/dev/null 2>&1; then
    access_code="$(curl -s -o /dev/null -w '%{http_code}' \
      -H "Authorization: Bearer $token" \
      -H "Accept: application/vnd.github+json" \
      "https://api.github.com/repos/${CHECK_REPO}")"

    if [ "$access_code" != "200" ]; then
        echo "ERROR: token cannot read ${CHECK_REPO} (HTTP $access_code)." >&2
        echo "Fix token permissions/resource owner, then rerun this command." >&2
        exit 1
    fi
fi

echo "[snowman] Running nixos-rebuild with temporary GitHub access token..."
sudo NIX_CONFIG="access-tokens = github.com=${token} api.github.com=${token}" \
  nixos-rebuild switch --flake "${REPO_ROOT}#${HOST}"

echo
echo "[snowman] Bootstrap rebuild completed."
echo "[snowman] Next runs should work with your normal: snowman prod"
